<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ summary or description or site.description }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
    <meta property="og:title" content="{% if title %}{{ title }} | {% endif %}{{ site.title }}">
    <meta property="og:description" content="{{ summary or description or site.description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta name="theme-color" content="#f5f1e8">
    <link rel="stylesheet" href="{{ '/assets/site.css' | url }}">
    {% if site.analytics and site.analytics.googleTagId %}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analytics.googleTagId }}"></script>
    <script>
      window.dataLayer = window.dataLayer || []
      function gtag() { dataLayer.push(arguments) }
      gtag('js', new Date())
      gtag('config', '{{ site.analytics.googleTagId }}')
    </script>
    {% endif %}
  </head>
  <body>
    {% set navMeetup = collections.meetups[0] %}
    {% set navLuma = false %}
    {% if navMeetup and navMeetup.data.luma and navMeetup.data.luma.eventUrl %}
      {% set navLuma = navMeetup.data.luma %}
    {% endif %}
    <div class="page-shell">
      <header class="site-header">
        <div class="container header-row">
          <a class="brand" href="{{ '/' | url }}">{{ site.title }}</a>
          <nav class="site-nav" aria-label="Primary">
            <a href="{{ '/#community' | url }}">Community</a>
            <a href="{{ '/#meetups' | url }}">Meetups</a>
            {% if navLuma %}
            <a
              class="button button-small luma-checkout--button"
              href="{{ navLuma.eventUrl }}"
              data-luma-action="checkout"
              data-luma-event-id="{{ navLuma.eventId }}"
            >
              RSVP
            </a>
            {% elif navMeetup %}
            <a class="button button-small" href="{{ navMeetup.url | url }}">Next</a>
            {% endif %}
          </nav>
        </div>
      </header>

      <main>
        {{ content | safe }}
      </main>

      <footer class="site-footer">
        <div class="container footer-row">
          <div>
            <p class="eyebrow">East Bay Tech</p>
            <p class="footer-copy">Practical AI, emerging technology, and real business conversations.</p>
            <p class="footer-organizer">
              <span>Hosted by {{ site.organizer.name }}</span>
              <span class="footer-social" aria-label="Organizer social links">
                <a href="{{ site.organizer.linkedinUrl }}" aria-label="LinkedIn profile" class="footer-icon-link">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.03-1.84-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.84 3.37-1.84 3.6 0 4.26 2.37 4.26 5.46zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14M7.12 20.45H3.56V9h3.56zM22.23 0H1.77A1.77 1.77 0 0 0 0 1.77v20.46C0 23.21.79 24 1.77 24h20.46A1.77 1.77 0 0 0 24 22.23V1.77A1.77 1.77 0 0 0 22.23 0"/>
                  </svg>
                </a>
                <a href="{{ site.organizer.xUrl }}" aria-label="X profile" class="footer-icon-link">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M17.53 3h3.07l-6.7 7.66L21.8 21h-6.18l-4.84-6.32L5.25 21H2.17l7.17-8.2L1.8 3h6.34l4.37 5.76zm-1.08 16.15h1.7L7.2 4.76H5.38z"/>
                  </svg>
                </a>
                <a href="{{ site.organizer.githubUrl }}" aria-label="GitHub profile" class="footer-icon-link">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.04c-3.34.73-4.04-1.42-4.04-1.42-.54-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.08 1.84 2.82 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.31-5.47-1.34-5.47-5.95 0-1.31.47-2.38 1.24-3.22-.13-.31-.54-1.56.12-3.24 0 0 1.01-.32 3.3 1.23a11.43 11.43 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.68.25 2.93.12 3.24.78.84 1.24 1.91 1.24 3.22 0 4.62-2.8 5.63-5.48 5.94.43.37.82 1.1.82 2.22v3.29c0 .32.21.7.83.58A12 12 0 0 0 12 .5"/>
                  </svg>
                </a>
              </span>
            </p>
          </div>
        </div>
      </footer>
    </div>
    {% if navLuma and navLuma.eventId %}
    <script id="luma-checkout" src="https://embed.lu.ma/checkout-button.js"></script>
    {% endif %}
    <script>
      document.querySelectorAll('a[href]').forEach((link) => {
        if (link.classList.contains('luma-checkout--button')) {
          return
        }

        const href = link.getAttribute('href')
        if (!href || href.startsWith('/') || href.startsWith('#')) {
          return
        }

        try {
          const url = new URL(href, window.location.origin)
          if (url.origin !== window.location.origin) {
            link.setAttribute('target', '_blank')
            link.setAttribute('rel', 'noreferrer')
          }
        } catch {
        }
      })
    </script>
  </body>
</html>
