---
layout: layouts/base.njk
---
{% set neighbors = collections.meetups | adjacentMeetups(page.url) %}
{% set isUpcomingMeetup = collections.meetups[0] and collections.meetups[0].url == page.url %}

<section class="section detail-hero{% if heroArt %} detail-hero-visual{% endif %}">
  {% if heroArt %}
  <div class="detail-hero-art" aria-hidden="true">
    {% for item in heroArt %}
    <img class="detail-hero-art-image detail-hero-art-image-{{ loop.index }}" src="{{ item | url }}" alt="">
    {% endfor %}
  </div>
  {% endif %}
  <div class="container detail-shell">
    <p class="micro-label">{% if isUpcomingMeetup %}Upcoming meetup{% else %}Past meetup{% endif %}</p>
    <h1>{{ title }}</h1>
    <p class="detail-meta">
      <span>Date</span>
      <strong>{{ meetupDate | formatMeetupSchedule(meetupTime) }}</strong>
      <span>Place</span>
      <strong>{{ location }}</strong>
    </p>
    {% if isUpcomingMeetup and luma and luma.eventId %}
    <div class="hero-actions preview-actions">
      <a
        href="{{ luma.eventUrl }}"
        class="button luma-checkout--button"
        data-luma-action="checkout"
        data-luma-event-id="{{ luma.eventId }}"
      >
        Register for this meetup
      </a>
    </div>
    {% endif %}
  </div>
</section>

<section class="section">
  <div class="container detail-shell">
    <div class="detail-main">
      <article class="prose detail-agenda">
        {{ content | safe }}
      </article>

      {% if neighbors.newer or neighbors.older %}
      <nav class="simple-nav" aria-label="Meetup navigation">
        {% if neighbors.newer %}
        <div class="simple-nav-item">
          <a href="{{ neighbors.newer.url | url }}" aria-label="Newer meetup: {{ neighbors.newer.data.title }}">Newer meetup</a>
          <span class="simple-nav-title">{{ neighbors.newer.data.title }}</span>
        </div>
        {% endif %}
        {% if neighbors.older %}
        <div class="simple-nav-item">
          <a href="{{ neighbors.older.url | url }}" aria-label="Older meetup: {{ neighbors.older.data.title }}">Older meetup</a>
          <span class="simple-nav-title">{{ neighbors.older.data.title }}</span>
        </div>
        {% endif %}
      </nav>
      {% endif %}
    </div>
  </div>
</section>
