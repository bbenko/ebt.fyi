---
layout: layouts/base.njk
---
{% set neighbors = collections.meetups | adjacentMeetups(page.url) %}
{% set isUpcomingMeetup = collections.meetups[0] and collections.meetups[0].url == page.url %}

<section class="section detail-hero">
  <div class="container detail-shell">
    <p class="eyebrow">{% if isUpcomingMeetup %}Upcoming meetup{% else %}Past meetup{% endif %}</p>
    <h1>{{ title }}</h1>
    <p class="detail-meta">
      <span>Date</span>
      <strong>{{ meetupDate | formatMeetupSchedule(meetupTime) }}</strong>
      <span>Place</span>
      <strong>{{ location }}</strong>
    </p>
    {% if isUpcomingMeetup and luma and luma.eventId %}
    <div class="hero-actions preview-actions">
      <a
        href="{{ luma.eventUrl }}"
        class="button luma-checkout--button"
        data-luma-action="checkout"
        data-luma-event-id="{{ luma.eventId }}"
      >
        Register for this meetup
      </a>
    </div>
    {% endif %}
  </div>
</section>

<section class="section">
  <div class="container detail-shell">
    <div class="detail-main">
      <article class="prose panel detail-agenda">
        {{ content | safe }}
      </article>

      {% if neighbors.newer or neighbors.older %}
      <nav class="simple-nav" aria-label="Meetup navigation">
        {% if neighbors.newer %}
        <a href="{{ neighbors.newer.url | url }}">Newer: {{ neighbors.newer.data.title }}</a>
        {% endif %}
        {% if neighbors.older %}
        <a href="{{ neighbors.older.url | url }}">Older: {{ neighbors.older.data.title }}</a>
        {% endif %}
      </nav>
      {% endif %}
    </div>
  </div>
</section>
