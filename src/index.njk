---
layout: layouts/base.njk
---
{% set meetups = collections.meetups %}
{% set featuredMeetup = meetups[0] %}

<section class="hero">
  <div class="container hero-grid hero-grid-single">
    <div class="hero-copy hero-copy-tight">
      <p class="eyebrow">East Bay Tech</p>
      <h1>Practical AI discussions in the East Bay</h1>
      <p class="lead">A small roundtable for founders, developers, and operators working with AI in the real world.</p>
      <p class="hero-kicker">We compare what is improving product, operations, and infrastructure, what still breaks in production, and what strong peers are learning faster than benchmarks can show.</p>
      {% set meetupCtaClass = "" %}
      {% include "components/meetup-cta.njk" %}
      <p class="hero-kicker">Seats are intentionally limited to keep discussion high-signal.</p>
    </div>
  </div>
</section>

<section class="section" id="community">
  <div class="container">
    <div class="section-header section-header-stack">
      <div>
        <p class="eyebrow">Community</p>
        <h2>The kinds of people you will meet.</h2>
        <p class="section-intro">This is a small room for people using AI in real work, not spectators looking for generic takes. The mix matters as much as the topic list: strong operators, technical builders, and domain experts who can compare notes at a useful level.</p>
      </div>
    </div>

    <div class="simple-home-card next-meetup-content">
      <div class="next-meetup-grid next-meetup-grid-single">
        <div class="next-meetup-block">
          <p class="eyebrow">Attendee mix</p>
          <ul class="preview-list room-list">
            {% for item in site.attendeeHighlights %}
            <li><strong>{{ item.who }}</strong> {{ item.aiWork }}</li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-current" id="meetups">
  <div class="container">
    <div class="section-header section-header-stack">
      <div>
        <p class="eyebrow">Next meetup</p>
        <h2>{{ featuredMeetup.data.title }}</h2>
        <p class="meta-line">{{ featuredMeetup.data.meetupDate | formatMeetupSchedule(featuredMeetup.data.meetupTime) }} | {{ featuredMeetup.data.location }}</p>
        <p class="hero-kicker">Free to attend.</p>
      </div>
    </div>

    <div class="simple-home-card next-meetup-content">
      <p class="section-intro next-meetup-intro">{{ featuredMeetup.data.agendaIntro }}</p>
      <div class="next-meetup-grid">
        <div class="next-meetup-block">
          <p class="eyebrow">What we discuss</p>
          <ul class="preview-list">
            {% for item in featuredMeetup.data.highlights %}
            <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
        <div class="next-meetup-block">
          <p class="eyebrow">Format</p>
          <ul class="preview-list">
            {% for item in featuredMeetup.data.sessionPlan %}
            <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
      </div>
      {% set meetupCtaClass = "preview-actions" %}
      {% include "components/meetup-cta.njk" %}
    </div>
  </div>
</section>

{% if meetups.length > 1 %}
<section class="section" id="archive">
  <div class="container">
    <div class="section-header">
      <div>
        <p class="eyebrow">Past meetups</p>
        <h2>Archive</h2>
      </div>
    </div>

    <div class="meetup-list">
      {% for meetup in meetups %}
      {% if meetup.url != featuredMeetup.url %}
      <a class="meetup-row" href="{{ meetup.url | url }}">
        <div>
          <p class="row-date">{{ meetup.data.meetupDate | formatMeetupSchedule(meetup.data.meetupTime) }}</p>
          <h3>{{ meetup.data.title }}</h3>
          <p class="row-summary">{{ meetup.data.summary }}</p>
        </div>
        <span class="arrow">View</span>
      </a>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
